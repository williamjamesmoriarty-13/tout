# --- PostgreSQL (superuser d'admin, utilisé uniquement à l'init du conteneur) ---
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=cd8a9f87c9a8e7fme_admin_pwd
POSTGRES_DB=university

# --- Comptes applicatifs dédiés, un par service, isolés par schéma ---
STUDENT_DB_USER=student_user
STUDENT_DB_PASSWORD=change_me_student_pwd

TEACHER_ADMIN_DB_USER=teacher_admin_user
TEACHER_ADMIN_DB_PASSWORD=change_me_teacher_admin_pwd

ENROLLMENT_DB_USER=enrollment_user
ENROLLMENT_DB_PASSWORD=change_me_enrollment_pwd

# --- Ports exposés côté hôte ---
STUDENT_SERVICE_PORT=5001
TEACHER_ADMIN_SERVICE_PORT=5002
ENROLLMENT_SERVICE_PORT=5003
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# --- URLs internes inter-services (réseau Docker interne, noms de service) ---
STUDENT_SERVICE_URL=http://student-service:5001
TEACHER_ADMIN_SERVICE_URL=http://teacher-admin-service:8080
ENROLLMENT_SERVICE_URL=http://enrollment-service:5003

